// Icon and version details of purpledisc.exe. winres.ps1 compiles this into
// rsrc_windows_amd64.syso, which go build links on Windows; scripts/bump-version.sh
// updates the version numbers here.
#pragma code_page(65001)

1 ICON "../../gui/windows/purpledisc.ico"

1 VERSIONINFO
FILEVERSION 4,0,0,0
PRODUCTVERSION 4,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Scharkenberg"
      VALUE "FileDescription", "Purple Disc for Deezer (terminal)"
      VALUE "FileVersion", "4.0.0"
      VALUE "InternalName", "purpledisc"
      VALUE "LegalCopyright", "© Scharkenberg; based on OpenDeezer © Cycl0o0. AGPL-3.0."
      VALUE "OriginalFilename", "purpledisc.exe"
      VALUE "ProductName", "Purple Disc for Deezer"
      VALUE "ProductVersion", "4.0.0"
      VALUE "Comments", "Unofficial open-source client for Deezer. https://github.com/Scharkenberg/PurpleDisc"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
