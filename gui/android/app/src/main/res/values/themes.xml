<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose-only host theme: a platform Material parent (no Material Components
         dependency needed). Colors are driven by the Compose theme at runtime; the window
         starts with the app's background and the launch mark's circle (MainActivity keeps the color). -->
    <style name="Theme.PurpleDisc" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>