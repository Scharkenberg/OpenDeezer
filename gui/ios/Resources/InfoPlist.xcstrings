{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف Purple Disc أجهزة Purple Disc Connect الأخرى ويستضيف التحكم بالهاتف عن بُعد عبر شبكتك المحلية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purple Disc detecta otros dispositivos Purple Disc Connect y aloja el control remoto del teléfono en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purple Disc détecte les autres appareils Purple Disc Connect et héberge la télécommande du téléphone sur votre réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Purple Disc आपके लोकल नेटवर्क पर अन्य Purple Disc Connect डिवाइस खोजता है और फ़ोन रिमोट होस्ट करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Purple Disc обнаруживает другие устройства Purple Disc Connect и запускает пульт для телефона в вашей локальной сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Purple Disc 需要通过本地网络发现其他 Purple Disc Connect 设备并提供手机遥控功能。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
