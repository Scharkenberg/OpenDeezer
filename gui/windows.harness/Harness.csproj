<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-screen measurements of the Windows app's own controls. Compiles gui\windows as is,
       minus its entry point, App.xaml.cs and MainWindow; never loads the engine or signs in.
       Run with run.ps1. Not part of the app or its solution. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PurpleDisc</RootNamespace>
    <AssemblyName>PdHarness</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <App>..\windows\</App>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.3.260402-preview2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
    <!-- The Windows App SDK components the app uses; the metapackage would also bring ML, AI,
         Search and Widgets (about 125 MB of unused ONNX and DirectML files). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(App)**\*.cs" Exclude="$(App)bin\**;$(App)obj\**;$(App)Program.cs;$(App)App.xaml.cs;$(App)Shell\MainWindow.cs" LinkBase="app" />
    <ApplicationDefinition Include="$(App)App.xaml" Link="App.xaml" />
    <PRIResource Include="$(App)Strings\**\*.resw" Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(App)purpledisc.ico" Link="purpledisc.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The app's font, so text measures as the app draws it. -->
    <Content Include="$(App)..\..\assets\fonts\InterVariable.ttf" Link="Fonts\InterVariable.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The app's obj\Version.g.cs counterpart (Config.AppVersion). -->
    <Compile Include="$(BaseIntermediateOutputPath)Version.g.cs" />
  </ItemGroup>
  <Target Name="WriteBuildInfo" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)Version.g.cs" Lines="internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
