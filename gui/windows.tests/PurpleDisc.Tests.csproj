<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the engine queue mirror. No WinUI, no engine DLL: the
       mirror source is linked from ..\windows and driven against FakeEngineQueue.
       Run: dotnet test (from this folder). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PurpleDisc.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\windows\EngineQueueMirror.cs" Link="Linked\EngineQueueMirror.cs" />
    <Compile Include="..\windows\Track.cs" Link="Linked\Track.cs" />
    <Compile Include="..\windows\Setup\Signature.cs" Link="Linked\Signature.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
