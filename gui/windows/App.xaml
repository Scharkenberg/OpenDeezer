<?xml version="1.0" encoding="utf-8"?>
<!-- Resources only: the accent, text and surface styles and the icon button
     templates the code-built UI picks by name (Ui.Styles). Colors come through
     ThemeResource setters, so light, dark and high contrast follow the system. -->
<Application
    x:Class="PurpleDisc.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Spacing in styles and templates stays on the 4-px grid (Space in Ui/Tokens.cs). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A page backdrop's veil: acrylic over the page's artwork, tinted like the window. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BackdropVeilBrush" Color="#FF1C1C1C" Opacity="0.62" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BackdropVeilBrush" Color="#FFF3F3F3" Opacity="0.7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BackdropVeilBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="BackdropVeil" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BackdropVeilBrush}" />
            </Style>
            <!-- A marquee label: a transparent fill, so the pointer is seen anywhere on it. -->
            <Style x:Key="MarqueePanel" TargetType="Panel">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>

            <!-- The mark's circle (assets/icon.svg), also the play triangle cut into its disc. -->
            <Color x:Key="MarkColor">#FF9A45FF</Color>
            <SolidColorBrush x:Key="MarkBrush" Color="{StaticResource MarkColor}" />
            <!-- The mark's outer arc and disc, and its inner arc and dot at 65 %. -->
            <Color x:Key="MarkLineColor">#FFFFFFFF</Color>
            <Color x:Key="MarkFaintColor">#A6FFFFFF</Color>

            <!-- Deezer violet as the system accent: every themed control derives from it. -->
            <Color x:Key="SystemAccentColor">#FFA238FF</Color>
            <Color x:Key="SystemAccentColorLight1">#FFB55BFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFC77EFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD9A3FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF8A1FE6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF7016C2</Color>
            <Color x:Key="SystemAccentColorDark3">#FF560F99</Color>

            <!-- Inter for all text: the themed text styles and controls read this key. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Fonts/InterVariable.ttf#Inter Variable</FontFamily>

            <!-- Text: body 15 and caption 13 (one step above the Fluent defaults, for a media app read at a distance). -->
            <Style x:Key="BaseBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="BaseCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
            <Style x:Key="HeroTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="MaxLines" Value="2" />
            </Style>
            <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />
            <Style x:Key="StrongText" TargetType="TextBlock" BasedOn="{StaticResource BaseBody}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseBody}" />
            <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseCaption}" />
            <Style x:Key="SecondaryBodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseBody}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryCaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseCaption}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TertiaryCaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseCaption}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="RowTitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseBody}" />
            <Style x:Key="RowTitlePlayingText" TargetType="TextBlock" BasedOn="{StaticResource BaseBody}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="RowTitlePlayedText" TargetType="TextBlock" BasedOn="{StaticResource BaseBody}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="LyricsLineText" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
            <Style x:Key="LyricsLineInactiveText" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="LyricsPlainText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="LineHeight" Value="28" />
            </Style>
            <Style x:Key="PairingCodeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="300" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource BaseCaption}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- Icons -->
            <Style x:Key="Icon12" TargetType="FontIcon">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="Icon16" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="Icon20" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="AccentIcon12" TargetType="FontIcon" BasedOn="{StaticResource Icon12}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="AccentIcon16" TargetType="FontIcon" BasedOn="{StaticResource Icon16}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SecondaryIcon20" TargetType="FontIcon" BasedOn="{StaticResource Icon20}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Surfaces -->
            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="4,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ArtBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="SmallArtBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="GeneratedArtBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="GeneratedArtIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="64" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SkeletonBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <!-- As SettingsCardPadding: a card beside settings cards lines up with them. -->
                <Setter Property="Padding" Value="12,8,12,8" />
            </Style>
            <!-- An opaque backing for the floating toast (InfoBar fills are translucent). -->
            <Style x:Key="ToastBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="ToastInfoBar" TargetType="InfoBar">
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="DividerLine" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- The navigation pane's resize grip: hit-testable when transparent, an accent line while hovered or dragged. -->
            <Style x:Key="PaneGrip" TargetType="Grid">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="GripLine" TargetType="Border">
                <Setter Property="Width" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <!-- The player bar's now-playing region: a card, so it reads as one place even when empty;
                 tighter, so the bar keeps its height. -->
            <Style x:Key="NowPlayingCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="Padding" Value="8,4" />
            </Style>
            <Style x:Key="BarGrid" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <!-- Buttons: subtle (transparent at rest), icon, icon toggle, play. -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Presenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Button and row sizes are set from Size in Ui/Tokens.cs (Ui.Square, Ui.PlayButton, TrackList), not here. -->
            <!-- Subtle with no padding: its content is the hit area (the bar's art and title). -->
            <Style x:Key="SubtleFlushButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="IndeterminatePointerOver" />
                                        <VisualState x:Name="IndeterminatePressed" />
                                        <VisualState x:Name="IndeterminateDisabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Presenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- Over artwork: a smoke scrim with white glyphs, legible on any cover in either theme. -->
            <Style x:Key="ArtScrimBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SmokeFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="ScrimIcon16" TargetType="FontIcon" BasedOn="{StaticResource Icon16}">
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="ScrimButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Foreground" Value="White" />
            </Style>
            <!-- Track rows: a focusable row in sections, the item container in full lists. -->
            <Style x:Key="TrackRowStyle" TargetType="ContentControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TrackRowHoverStyle" TargetType="ContentControl" BasedOn="{StaticResource TrackRowStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TrackListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <!-- Settings cards: the toolkit's lightweight-styling keys, tightened to the app's density.
                 A card is a row high (Size.Row). -->
            <Thickness x:Key="SettingsCardPadding">12,8,12,8</Thickness>
            <x:Double x:Key="SettingsCardMinHeight">44</x:Double>
            <Thickness x:Key="SettingsCardHeaderIconMargin">2,0,12,0</Thickness>
            <Thickness x:Key="SettingsCardVerticalHeaderContentSpacing">0,6,0,0</Thickness>
            <Thickness x:Key="SettingsExpanderHeaderPadding">12,8,4,8</Thickness>
            <Thickness x:Key="SettingsExpanderItemPadding">48,4,40,4</Thickness>
            <x:Double x:Key="SettingsExpanderContentMinHeight">40</x:Double>
            <!-- The control moves under the header only when the card is narrower than this. -->
            <x:Double x:Key="SettingsCardWrapThreshold">360</x:Double>
            <x:Double x:Key="SettingsCardWrapNoIconThreshold">280</x:Double>
            <Style x:Key="ColumnHeaderGrid" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="8,0,8,8" />
            </Style>
            <Style x:Key="PlayRingStyle" TargetType="ProgressRing">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <!-- The navigation pane's surface runs to the player bar when it slides over the page. -->
            <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,0</Thickness>
            <Thickness x:Key="NavigationViewBorderThickness">0,0,1,0</Thickness>
            <!-- The title-bar search box fits the 32-px bar with room above and below. -->
            <Style x:Key="TitleBarSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,3,6,4" />
            </Style>
            <!-- A link among plain values: the values' color, no border offset. -->
            <Style x:Key="ValueLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="LinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
