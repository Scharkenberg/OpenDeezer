<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# WinUI 3 (.NET 11), unpackaged + self-contained. The XAML markup compiler
       runs over App.xaml, so XamlControlsResources resolves the WinUI theme
       dictionary. The Go engine DLL
       (lib\libdeezercore.dll) is loaded by name at runtime via P/Invoke (no
       import lib needed) and copied next to PurpleDisc.exe by build.ps1.
       Build it with build.ps1 (dotnet publish, self-contained, win-x64). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PurpleDisc</RootNamespace>
    <!-- Built from app.manifest with the version stamped in (StampManifestVersion). -->
    <ApplicationManifest>$(BaseIntermediateOutputPath)app.versioned.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- No module initializer: it loads Microsoft.WindowsAppRuntime.dll before Main, and uninstall.exe
         (PurpleDisc.exe alone, Setup/Installer.cs) has no such file. Program.Main calls it instead. -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The [LibraryImport] source generator and the tray's fixed buffers and function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>purpledisc.ico</ApplicationIcon>
    <!-- Single version source: About reads it from BuildInfo (WriteBuildInfo). -->
    <Version>4.0.0</Version>
    <!-- Native AOT publish for AVX2-class CPUs (x86-64-v3, as the engine DLL's GOAMD64=v3), built for
         size (owner's decision): the exe's hot paths are WinUI and the engine, not managed loops.
         Exception texts stay English (no UseSystemResourceKeys); stack traces stay. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <IlcTreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</IlcTreatWarningsAsErrors>
    <!-- No symbols in Release, managed or native: AppLog's stack traces have no line numbers under AOT. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Features>$(Features);runtime-async=on</Features>
    <!-- The locales under Strings. -->
    <SatelliteResourceLanguages>en-US;zh-CN;hi-IN;es-ES;fr-FR;ar-SA;ru-RU</SatelliteResourceLanguages>
    <!-- Program.cs owns Main (single-instance redirect before XAML starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.3.260402-preview2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
    <!-- The Windows App SDK components the app uses; the metapackage would also bring ML, AI,
         Search and Widgets (about 125 MB of unused ONNX and DirectML files). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine build.ps1 makes, beside the exe of every build. -->
    <None Update="lib\libdeezercore.dll" Link="libdeezercore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Loose copy for AppWindow.SetIcon / the tray's small icon (LoadImage). -->
    <Content Include="purpledisc.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Inter, the UI font (variable), with its license (SIL OFL 1.1), kept once in assets\fonts. -->
    <Content Include="..\..\assets\fonts\InterVariable.ttf" Link="Fonts\InterVariable.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\fonts\Inter-OFL.txt" Link="Fonts\Inter-OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Localization: MRT Core resources. The .NET SDK's EnableDefaultPriItems globs
       Strings\**\*.resw automatically, so we do NOT list them explicitly (doing so
       trips NETSDK1022 "Duplicate PRIResource items"). MakePri compiles them into
       resources.pri (one resource subtree "Resources", one qualifier per locale
       folder) which ships next to PurpleDisc.exe and is read by Loc.cs at runtime. -->
  <!-- One version source. app.manifest carries a $VERSION$ placeholder; this
       writes obj\app.versioned.manifest with <Version> as the 4-part number Win32
       manifests require ("4.0.0" -> "4.0.0.0"; a "-beta" suffix is dropped). -->
  <Target Name="StampManifestVersion" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_StampV>$(Version.Split('-')[0])</_StampV>
      <_StampManifestVersion>$([System.Version]::Parse('$(_StampV)').Major).$([System.Version]::Parse('$(_StampV)').Minor).$([System.Math]::Max(0, $([System.Version]::Parse('$(_StampV)').Build))).$([System.Math]::Max(0, $([System.Version]::Parse('$(_StampV)').Revision)))</_StampManifestVersion>
      <_StampText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.manifest').Replace('$VERSION$', '$(_StampManifestVersion)'))</_StampText>
    </PropertyGroup>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)app.versioned.manifest" Lines="$([MSBuild]::Escape('$(_StampText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <!-- An unpackaged Native AOT publish leaves the compiled XAML (.xbf) and the resource index
       (.pri) out of the publish folder (Windows App SDK issue 6394): they come from the build output. -->
  <Target Name="CopyXamlAndPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlAndPri Include="$(OutDir)*.xbf;$(OutDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlAndPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Files of the Windows App SDK the app never uses, removed from the publish folder by name (a name
       a later SDK no longer ships is skipped): WinUI's strings in the 79 languages the app does not
       have (it ships seven: SatelliteResourceLanguages), the .winmd metadata a Native AOT app never
       reads, DLLs no import, manifest entry or name string points at, and helpers for features the
       app does not have. -->
  <Target Name="RemoveUnusedFromPublish" AfterTargets="CopyXamlAndPriToPublish">
    <ItemGroup>
      <_UnusedMui Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)en-us\*.mui;$(PublishDir)zh-CN\*.mui;$(PublishDir)hi-IN\*.mui;$(PublishDir)es-ES\*.mui;$(PublishDir)fr-FR\*.mui;$(PublishDir)ar-SA\*.mui;$(PublishDir)ru-RU\*.mui" />
      <_UnusedMuiDir Include="@(_UnusedMui->'%(RootDir)%(Directory)')" />
      <_Unused Include="@(_UnusedMui);$(PublishDir)*.winmd" />
      <_Unused Include="$(PublishDir)DWriteCore.dll;$(PublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll;$(PublishDir)WebView2Loader.dll;$(PublishDir)PushNotificationsLongRunningTask.ProxyStub.dll" />
      <_Unused Include="$(PublishDir)Microsoft.UI.Designer.dll;$(PublishDir)Microsoft.WindowsAppRuntime.Background.UniversalBGTask.dll;$(PublishDir)Microsoft.UI.Xaml\Assets\map.html" />
      <_Unused Include="$(PublishDir)Microsoft.UI.Xaml.Controls.pri" />
    </ItemGroup>
    <Delete Files="@(_Unused)" />
    <RemoveDir Directories="@(_UnusedMuiDir->Distinct())" />
  </Target>
  <!-- obj\Version.g.cs: the version as a constant (Config.AppVersion), compiled in. -->
  <ItemGroup>
    <Compile Include="$(BaseIntermediateOutputPath)Version.g.cs" />
  </ItemGroup>
  <Target Name="WriteBuildInfo" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)Version.g.cs" Lines="internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
