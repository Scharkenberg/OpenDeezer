#pragma code_page(65001)
// The installer stub's icon, version details and manifest; sfx.ps1 fills the $...$ values.
1 ICON "$ICON$"
1 24 "$MANIFEST$"
1 VERSIONINFO
FILEVERSION $VERSIONCOMMA$
PRODUCTVERSION $VERSIONCOMMA$
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Scharkenberg"
      VALUE "FileDescription", "Purple Disc for Deezer"
      VALUE "FileVersion", "$VERSION$"
      VALUE "LegalCopyright", "© Scharkenberg; based on OpenDeezer © Cycl0o0. Self-extractor: 7-Zip by Igor Pavlov (public domain)."
      VALUE "OriginalFilename", "PurpleDisc-$VERSION$-windows-x64.exe"
      VALUE "ProductName", "Purple Disc for Deezer"
      VALUE "ProductVersion", "$VERSION$"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
